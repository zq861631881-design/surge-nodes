#!name=自动加入TestFlight
#!desc=自动加入/监控TestFlight：先打开 TestFlight App 抓取账号令牌，再填应用 ID，定时任务有空位就自动加入；监控模式不需要令牌也无需 MITM。由 Loon 插件 Auto_Join_TF 改写为 Surge 模块，原作者奶思(fmz200)/DecoAri/xream。
#!author=奶思[https://github.com/fmz200], DecoAri[https://github.com/DecoAri], xream[https://github.com/xream]
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/TestFlight_00.png
#!homepage=https://github.com/fmz200/wool_scripts
#!category=定时任务
#!date=2026-11-22 19:40:00

# 使用步骤（和原插件一致）：
# 1. 安装本模块后，在 Surge 的 MITM 设置里确认已开启 HTTP/2 解密（TestFlight 走 HTTP/2，不开抓不到令牌）。
# 2. 打开 TestFlight App 逛一下，收到“获取成功”通知即令牌已存好。
# 3. 在 Surge 持久化数据（或 BoxJS）里加一条：key 填 fmz200_TF_APP_ID，value 填要加入的 TF 应用 ID（join 链接 https://testflight.apple.com/join/ 后面的那串字符），多个用英文逗号隔开，如 LPQmtkUs,Hgun65jg。也可以直接在 Safari 里打开 join 链接，模块会自动把 ID 记下来。
# 4. 两个定时任务默认都开着：自动加入每 3 分钟跑一次，监控每 1 分钟跑一次。不用哪个就去 Surge 脚本列表里关掉对应的脚本。
# 注意：监控任务不需要令牌、不用 MITM 也能跑；自动加入需要先抓到令牌。

[Rule]
DOMAIN-SUFFIX,testflight.apple.com,Proxy

[MITM]
hostname = %APPEND% testflight.apple.com

[Script]
获取账号令牌 = type=http-request, pattern=^https?:\/\/testflight\.apple\.com\/v3\/accounts\/.*\/apps$, script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/TestFlight/AutoJoinTFKeys.js, requires-body=false, timeout=60
应用ID捕获 = type=http-request, pattern=^https?:\/\/testflight\.apple\.com\/join\/(.*), script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/TestFlight/AutoJoinTFKeys.js, requires-body=false, timeout=60
自动加入TF = type=cron, cronexp=*/3 * * * *, script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/TestFlight/AutoJoinTF.js, wake-system=1, timeout=600
监控TF位置 = type=cron, cronexp=* * * * *, script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/TestFlight/AutoMonitorTF.js, wake-system=1, timeout=30
